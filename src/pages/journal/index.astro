---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Journal | Mariana Ordonez"
  description="Field notes, reflections, and shorter journal entries from Mariana Ordonez."
>
  <main class="archive">
    <p class="eyebrow">Journal</p>
    <h1>Notes from the process</h1>
    <div class="post-list">
      {
        entries.map((entry) => (
          <article>
            <a href={`/journal/${entry.id}/`}>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <time datetime={entry.data.pubDate.toISOString()}>
                {entry.data.pubDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                  year: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </a>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>
