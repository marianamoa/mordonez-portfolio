---
import Layout from "../layouts/Layout.astro";
import { capabilities, experience, site, socialLinks, contactHref } from "../data/site";

const profileSchema = {
	"@context": "https://schema.org",
	"@type": "ProfilePage",
	mainEntity: {
		"@type": "Person",
		name: site.name,
		jobTitle: site.role,
		url: site.url,
		email: site.email,
	},
};
---

<Layout
	title="About - Remote Product Designer, US Hours, Colombia"
	description="Remote product and eCommerce designer in Colombia, working US hours. 6+ years in CRO, UX and AI-assisted design for Amazon, Walmart, Target and Ferrero brands."
	path="/about/"
	type="profile"
>
	<script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>Remote nearshore product designer</p>
			<h1 class="page-title">I design things that have to perform.</h1>
			<p class="page-lede">
				I am a product, UX and eCommerce designer with 6+ years designing conversion-focused
				commerce and product experiences. AI is how I work faster. Craft is how the work stays
				worth shipping.
			</p>
			<div class="actions">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href={site.resumeUrl}>Download resume</a>
			</div>
		</section>

		<section class="container section tight feature-split">
			<div>
				<p class="kicker">How I work</p>
				<h2 class="section-title">Senior US-quality craft, inside your workday.</h2>
				<p class="section-copy">
					I am based in Colombia, UTC-5, bilingual and experienced with fully remote EST teams
					since 2018. That means real-time collaboration with US teams, not overnight handoff.
				</p>
			</div>
			<div class="demo-panel">
				<div class="demo-screen">
					<div class="demo-row"><strong>Timezone</strong><span>UTC-5</span></div>
					<div class="demo-row"><strong>Remote experience</strong><span>Since 2018</span></div>
					<div class="demo-row"><strong>Focus</strong><span>AI, UX, CRO</span></div>
					<div class="demo-row"><strong>Availability</strong><span>US business hours</span></div>
				</div>
			</div>
		</section>

		<section class="container section">
			<div class="section-head">
				<div>
					<p class="kicker">Experience and clients</p>
					<h2 class="section-title">Six years of work that had to ship.</h2>
				</div>
				<a class="text-link" href="/work/">View case studies -></a>
			</div>
			<div class="timeline">
				{experience.map((item) => <div class="timeline-item">{item}</div>)}
			</div>
		</section>

		<section class="container section tight">
			<div class="section-head">
				<div>
					<p class="kicker">Skills and tools</p>
					<h2 class="section-title">What I bring to a team.</h2>
				</div>
			</div>
			<div class="grid-3">
				{
					capabilities.map((capability) => (
						<article class="card">
							<h3>{capability.title}</h3>
							<p>{capability.description}</p>
							<div class="tags">
								{capability.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="container section tight">
			<div class="grid-2">
				<article class="card">
					<p class="kicker">Certification</p>
					<h2>IBM Generative AI for UX Design.</h2>
					<p>
						A credibility marker for AI-assisted research, ideation and product-design workflows.
					</p>
				</article>
				<article class="card">
					<p class="kicker">Profiles</p>
					<h2>One clear identity across platforms.</h2>
					<p>
						AI Product & eCommerce Designer stays consistent across LinkedIn, Dribbble,
						Behance, Instagram, email and resume touchpoints.
					</p>
					<div class="tags">
						{socialLinks.map((link) => <span class="tag">{link.label}</span>)}
					</div>
				</article>
			</div>
		</section>

		<section class="container cta-band">
			<h2>Let's build something that performs.</h2>
			<p>I am open to remote product, UX and eCommerce design roles.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href={contactHref}>Email Mariana <span aria-hidden="true">-></span></a>
				<a class="text-link" href={site.resumeUrl}>Download resume</a>
			</div>
		</section>
	</main>
</Layout>
