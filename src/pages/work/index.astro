---
import Layout from "../../layouts/Layout.astro";
import { caseStudies, site } from "../../data/site";
---

<Layout
	title="Work - CRO & AI Product Design Case Studies"
	description="UX and CRO design case studies by Mariana Ordonez: eCommerce redesigns, AI-assisted workflows, design systems and marketplace conversion work."
	path="/work/"
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>UX / CRO design case studies</p>
			<h1 class="page-title">Case studies in CRO, product and AI design.</h1>
			<p class="page-lede">
				Real, shipped work across conversion-focused commerce, marketplace PDP optimization,
				scalable design systems and an AI-native design workflow.
			</p>
			<div class="pill-row" aria-label="Case study filters">
				<span class="pill">CRO</span>
				<span class="pill">AI Product</span>
				<span class="pill">UI/UX</span>
				<span class="pill">Design systems</span>
				<span class="pill">Brand</span>
			</div>
		</section>

		<section class="container section tight">
			<div class="grid-2">
				{
					caseStudies.map((study) => (
						<a class="card work-card" href={`/work/${study.slug}/`}>
							<div class="work-copy">
								<p class="kicker">{study.client}</p>
								<h2>{study.outcome}</h2>
								<p>{study.summary}</p>
								<div class="tags">
									{study.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
								<p class="metric">{study.impact}</p>
							</div>
							<div class="work-art" aria-label={`${study.title} visual summary`}></div>
						</a>
					))
				}
			</div>
		</section>

		<section class="container cta-band">
			<h2>Want this kind of work on your product?</h2>
			<p>Send the role, product or funnel. I will reply in US business hours.</p>
			<div class="actions" style="justify-content: center">
				<a class="button" href="/contact/">Get in touch <span aria-hidden="true">-></span></a>
				<a class="text-link" href="/">Back to home</a>
			</div>
		</section>
	</main>
</Layout>
