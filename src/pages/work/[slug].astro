---
import Layout from "../../layouts/Layout.astro";
import { caseStudies, site } from "../../data/site";

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
const nextStudy = caseStudies[(caseStudies.findIndex((item) => item.slug === study.slug) + 1) % caseStudies.length];

const media = study as {
	cover?: string;
	gallery?: { src: string; title?: string; caption: string }[];
	liveLinks?: { label: string; detail?: string; url: string }[];
};
const cover = media.cover;
const gallery = media.gallery;
const liveLinks = media.liveLinks;
---

<Layout
	title={`${study.title} - UX / CRO Case Study`}
	description={`${study.outcome} ${study.summary}`}
	path={`/work/${study.slug}/`}
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>{study.client}</p>
			<h1 class="page-title">{study.outcome}</h1>
			<p class="page-lede">{study.summary}</p>
			<div class="pill-row">
				{study.tags.map((tag) => <span class="pill">{tag}</span>)}
			</div>
		</section>

		{
			cover && (
				<section class="container cs-cover">
					<img src={cover} alt={`${study.client} - ${study.outcome}`} width="1600" loading="eager" />
				</section>
			)
		}

		<section class="container cs-meta" aria-label="Case study details">
			<div><span>Role</span><strong>{study.role}</strong></div>
			<div><span>Timeline</span><strong>{study.timeline}</strong></div>
			<div><span>Dates</span><strong>{study.period}</strong></div>
			<div><span>Tools</span><strong>{study.tools}</strong></div>
			<div>
				<span>Contact</span>
				<a class="text-link" href={`mailto:${site.email}`}>Discuss a project</a>
			</div>
		</section>

		<section class="container section tight cs-body">
			<div class="prose">
				<h2>The problem</h2>
				<p>{study.problem}</p>

				<h2>My process</h2>
				<ul>
					{study.process.map((step) => <li>{step}</li>)}
				</ul>

				<h2>The solution</h2>
				<p>{study.solution}</p>
			</div>

			{
				gallery && (
					<div class="cs-features">
						{gallery.map((shot) => (
							<figure class="cs-feature">
								<figcaption>
									{shot.title && <strong>{shot.title}</strong>}
									<span>{shot.caption}</span>
								</figcaption>
								<img src={shot.src} alt={shot.title ?? shot.caption} loading="lazy" />
							</figure>
						))}
					</div>
				)
			}

			{
				liveLinks && (
					<div class="cs-live">
						<h2>See it live</h2>
						<p class="cs-live-note">Public retailer listings I designed the conversion content for.</p>
						<ul class="cs-live-list">
							{liveLinks.map((link) => (
								<li>
									<a href={link.url} target="_blank" rel="noopener">
										<strong>{link.label}</strong>
										{link.detail && <span>{link.detail}</span>}
										<span class="cs-live-arrow" aria-hidden="true">-></span>
									</a>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<div class="prose">
				<h2>Impact</h2>
				<p><strong>{study.impact}</strong></p>
			</div>

			<div class="actions cs-end">
				<a class="button" href={`/work/${nextStudy.slug}/`}>Next project <span aria-hidden="true">-></span></a>
				<a class="text-link" href="/work/">All work</a>
			</div>
		</section>
	</main>
</Layout>
