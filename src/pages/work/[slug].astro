---
import Layout from "../../layouts/Layout.astro";
import { caseStudies, site } from "../../data/site";

export function getStaticPaths() {
	return caseStudies.map((study) => ({
		params: { slug: study.slug },
		props: { study },
	}));
}

const { study } = Astro.props;
const nextStudy = caseStudies[(caseStudies.findIndex((item) => item.slug === study.slug) + 1) % caseStudies.length];

const media = study as {
	cover?: string;
	gallery?: { src: string; caption: string }[];
};
const cover = media.cover;
const gallery = media.gallery;
---

<Layout
	title={`${study.title} - UX / CRO Case Study`}
	description={`${study.outcome} ${study.summary}`}
	path={`/work/${study.slug}/`}
>
	<main>
		<section class="container page-hero">
			<p class="eyebrow"><span class="dot" aria-hidden="true"></span>{study.client}</p>
			<h1 class="page-title">{study.outcome}</h1>
			<p class="page-lede">{study.summary}</p>
			<div class="pill-row">
				{study.tags.map((tag) => <span class="pill">{tag}</span>)}
			</div>
		</section>

		{
			cover && (
				<section class="container cs-cover">
					<img src={cover} alt={`${study.client} - ${study.outcome}`} width="1600" loading="eager" />
				</section>
			)
		}

		<section class="container section tight detail-grid">
			<article class="prose">
				<h2>The problem</h2>
				<p>{study.problem}</p>

				<h2>My process</h2>
				<ul>
					{study.process.map((step) => <li>{step}</li>)}
				</ul>

				<h2>The solution</h2>
				<p>{study.solution}</p>

				<h2>Impact</h2>
				<p><strong>{study.impact}</strong></p>

				<div class="actions">
					<a class="button" href={`/work/${nextStudy.slug}/`}>Next project <span aria-hidden="true">-></span></a>
					<a class="text-link" href="/work/">All work</a>
				</div>
			</article>

			<aside class="aside" aria-label="Case study details">
				<dl>
					<dt>Role</dt>
					<dd>{study.role}</dd>
					<dt>Timeline</dt>
					<dd>{study.timeline}</dd>
					<dt>Dates</dt>
					<dd>{study.period}</dd>
					<dt>Tools</dt>
					<dd>{study.tools}</dd>
					<dt>Contact</dt>
					<dd><a class="text-link" href={`mailto:${site.email}`}>Discuss a project</a></dd>
				</dl>
			</aside>
		</section>

		{
			gallery && (
				<section class="container section cs-gallery">
					<div class="section-head">
						<div>
							<p class="kicker">Selected screens</p>
							<h2 class="section-title">Inside the work.</h2>
						</div>
					</div>
					<div class="cs-gallery-grid">
						{gallery.map((shot) => (
							<figure class="cs-shot">
								<img src={shot.src} alt={shot.caption} loading="lazy" />
								<figcaption>{shot.caption}</figcaption>
							</figure>
						))}
					</div>
				</section>
			)
		}
	</main>
</Layout>
